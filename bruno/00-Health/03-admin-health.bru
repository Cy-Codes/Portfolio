meta {
  name: Admin Health Liveness
  type: http
  seq: 3
}

get {
  url: {{adminBaseUrl}}/health
  body: none
  auth: none
}

tests {
  test("Admin health returns 200 UP", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("UP");
    expect(res.body.service).to.equal("server-admin");
  });
}
