meta {
  name: Public Health Readiness
  type: http
  seq: 2
}

get {
  url: {{publicBaseUrl}}/health/ready
  body: none
  auth: none
}

tests {
  test("Public readiness returns 200 READY with Postgres schema", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("READY");
    expect(res.body.databaseReady).to.equal(true);
    expect(res.body.appliedMigrationCount).to.be.above(0);
  });
}
