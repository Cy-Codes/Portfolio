meta {
  name: Update Skill
  type: http
  seq: 3
}

put {
  url: {{adminBaseUrl}}/api/v1/admin/skills/{{createdSkillId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "{{tempSkillName}}-Updated",
    "category": "Verification",
    "isFeatured": true,
    "sortOrder": 100
  }
}

tests {
  test("Update skill returns 200 OK", function() {
    expect(res.status).to.equal(200);
    expect(res.body.isFeatured).to.equal(true);
  });
}
