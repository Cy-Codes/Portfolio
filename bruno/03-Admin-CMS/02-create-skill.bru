meta {
  name: Create Skill
  type: http
  seq: 2
}

post {
  url: {{adminBaseUrl}}/api/v1/admin/skills
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "{{tempSkillName}}",
    "category": "Verification",
    "isFeatured": false,
    "sortOrder": 99
  }
}

script:pre-request {
  bru.setVar("tempSkillName", "Bruno-Smoke-Skill-" + Date.now());
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("createdSkillId", res.body.id);
  }
}

tests {
  test("Create skill returns 201 Created with Location header", function() {
    expect(res.status).to.equal(201);
    expect(res.headers.location).to.include("/api/v1/admin/skills/");
  });
}
