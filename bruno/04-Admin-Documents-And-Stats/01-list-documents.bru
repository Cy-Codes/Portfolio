meta {
  name: List Admin Documents
  type: http
  seq: 1
}

get {
  url: {{adminBaseUrl}}/api/v1/admin/documents?page=1&pageSize=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:query {
  page: 1
  pageSize: 20
}

tests {
  test("Admin list documents returns paged documents", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.above(0);
  });
}
