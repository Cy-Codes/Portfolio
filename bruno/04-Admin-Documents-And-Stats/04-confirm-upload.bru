meta {
  name: Confirm Uploaded Document
  type: http
  seq: 4
}

post {
  url: {{adminBaseUrl}}/api/v1/admin/documents/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "documentId": "{{uploadDocumentId}}",
    "storageKey": "{{uploadStorageKey}}",
    "title": "Bruno Smoke Verification PDF",
    "category": "PAPER",
    "originalFilename": "bruno-smoke.pdf",
    "declaredMimeType": "application/pdf",
    "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "isPublic": true
  }
}

tests {
  test("Confirm verifies MinIO magic bytes and creates 201 document record", function() {
    expect(res.status).to.equal(201);
    expect(res.headers.location).to.include("/api/v1/admin/documents/");
    expect(res.body.mimeType).to.equal("application/pdf");
    expect(res.body.isPublic).to.equal(true);
  });
}
