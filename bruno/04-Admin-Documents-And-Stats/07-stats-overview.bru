meta {
  name: Get Admin Stats Overview
  type: http
  seq: 7
}

get {
  url: {{adminBaseUrl}}/api/v1/admin/stats/overview?range=30d
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

params:query {
  range: 30d
}

tests {
  test("Analytics overview aggregates seeded and recent events", function() {
    expect(res.status).to.equal(200);
    expect(res.body.range).to.equal("30d");
    expect(res.body.totalEvents).to.be.above(0);
    expect(res.body.byPlatform).to.be.an("array");
    expect(res.body.byViewportTier).to.be.an("array");
  });
}
