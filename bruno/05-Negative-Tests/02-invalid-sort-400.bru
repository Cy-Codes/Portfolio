meta {
  name: Invalid Sort Column Returns 400
  type: http
  seq: 2
}

get {
  url: {{publicBaseUrl}}/api/v1/public/projects?sortBy=drop_table
  body: none
  auth: none
}

params:query {
  sortBy: drop_table
}

tests {
  test("Allowlist rejects unknown sortBy column with 400 validation_error", function() {
    expect(res.status).to.equal(400);
    expect(res.body.type).to.equal("validation_error");
  });
}
