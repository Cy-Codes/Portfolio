meta {
  name: List Published Writeups By Tag
  type: http
  seq: 1
}

get {
  url: {{publicBaseUrl}}/api/v1/public/writeups?tag=ktor
  body: none
  auth: none
}

params:query {
  tag: ktor
}

tests {
  test("Tag filter returns only published writeups", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.above(0);
    res.body.items.forEach(function(item) {
      expect(item.status).to.equal("PUBLISHED");
    });
  });
}
