meta {
  name: Full-Text Search Writeups
  type: http
  seq: 2
}

get {
  url: {{publicBaseUrl}}/api/v1/public/writeups?q=Decompose
  body: none
  auth: none
}

params:query {
  q: Decompose
}

tests {
  test("Postgres tsvector search returns matching writeups", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.be.above(0);
  });
}
