# ==============================================================================
# Portfolio (.gitignore) — Public Repository Exclusions
# ==============================================================================

# --- Secrets, Local Environment & Credentials ---
.env
.env.*
!.env.example
local.properties
*.pem
*.key
*.p12
*.jks
*.keystore
*.secret.bru
bruno/environments/*.local.bru
*service-account*.json
*credentials*.json

# --- Terraform / IaC (Public Repository Guardrails) ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Kotlin Toolchain (Amper), Gradle, JVM & Build Outputs ---
build/
out/
.kotlin/
.amper/
.gradle/
*.iml
*.hprof
*.jfr
hs_err_pid*.log
replay_pid*.log

# --- Web / WasmJS / Node ---
node_modules/
kotlin-js-store/
dist/

# --- Android ---
captures/
*.apk
*.aab
*.ap_
*.dex
.cxx/

# --- Apple / Xcode / iOS ---
!**/module.xcodeproj/project.pbxproj
**/xcshareddata/WorkspaceSettings.xcsettings
xcuserdata/
*.xcuserstate
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.moved-aside
*.hmap

# --- IDEs & Editors ---
.idea/
.vscode/
.fleet/
*.swp
*.swo
*~

# --- Python (Git Hooks & Tooling) ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# --- OS, Logs & Temporary Files ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*.log
.tmp/
tmp/

# --- Local AI / Agent Tooling ---
.claude/
.cursor/
.gemini/
.antigravity/
/skills/system/
