# ============================================================================
# Portfolio Local Development Environment Contract
# Copy to git-ignored `.env` (`cp .env.example .env`) and customize as needed.
# Never commit real secrets or production credentials.
# ============================================================================

# Network binding (localhost-only by default for local dev security)
HOST_BIND_ADDRESS=127.0.0.1

# Pinned container image tags (never use :latest)
POSTGRES_IMAGE_TAG=16.8-alpine
FLYWAY_IMAGE_TAG=11.8-alpine
FAKE_GCS_IMAGE_TAG=1.52.2
CURL_IMAGE_TAG=8.12.1

# PostgreSQL connection and three-tier least-privilege roles
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=portfolio
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev_postgres_superuser_change_me

PORTFOLIO_MIGRATOR_USER=portfolio_migrator
PORTFOLIO_MIGRATOR_PASSWORD=dev_migrator_change_me

PORTFOLIO_ADMIN_USER=portfolio_admin
PORTFOLIO_ADMIN_PASSWORD=dev_admin_change_me

PORTFOLIO_PUBLIC_USER=portfolio_public
PORTFOLIO_PUBLIC_PASSWORD=dev_public_change_me

# Native Google Cloud Storage (fake-gcs-server locally, keyless ADC on GCP Cloud Run)
GCS_EMULATOR_PORT=4443
GCS_BUCKET_NAME=portfolio-assets
GCS_PROJECT_ID=portfolio-local
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443
STORAGE_EMULATOR_PUBLIC_HOST=http://127.0.0.1:4443

# Ktor servers (compile-time split public and admin services)
PUBLIC_SERVER_HOST=0.0.0.0
PUBLIC_SERVER_PORT=8080
ADMIN_SERVER_HOST=127.0.0.1
ADMIN_SERVER_PORT=8081
PUBLIC_SITE_BASE_URL=http://127.0.0.1:8080
ANALYTICS_DAILY_SALT=dev-portfolio-analytics-salt
APP_ENV=dev
APP_IMAGE_TAG=local-dev

# Local dev-profile JWT secret (never use in production)
DEV_JWT_SECRET=dev-only-portfolio-hs256-secret-minimum-32-bytes

# Production Admin OIDC / Google OAuth (leave blank for local dev JWT mode)
OAUTH_GOOGLE_CLIENT_ID=
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
ADMIN_ALLOWED_SUBJECTS=dev-owner
